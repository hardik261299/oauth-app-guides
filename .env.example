# Copy to .env (never commit it). Without a key the app runs in "stub" mode.

# Free option (default): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional paid alternative, used only if GEMINI_API_KEY is empty
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Max live generations per IP per hour (best-effort, in-memory). Keep low on free quotas.
GENERATE_LIMIT_PER_HOUR=10
PORT=3000
